# PostgreSQL. Use a strong password and require TLS for managed production databases.
DATABASE_URL="postgresql://iocl:iocl_secure_password@localhost:5432/iocl_gate?schema=public"

# API
API_PORT=4000
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=7d
SESSION_MAX_TTL=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=
COOKIE_NAME=iocl_refresh
FACILITY_CODE=IOCL-COIMBATORE
GATE_CODE=IN-GATE-01
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
