# Managed PostgreSQL is recommended. Use the provider/region approved by the client,
# require TLS, connection pooling where appropriate, backups, and network restrictions.
DATABASE_URL="postgresql://<user>:<password>@<managed-postgres-host>:5432/<database>?sslmode=require"

# API server
API_PORT=4000
NODE_ENV=production
WEB_ORIGINS=https://gate.example.com

# JWT authentication — generate independent random secrets, for example with:
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-an-independent-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-an-independent-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=7d
SESSION_MAX_TTL=8h

# Cookies and browser security
COOKIE_SECURE=true
# strict is preferred for same-site web/API hosts. Use none only for a genuinely
# cross-site deployment; the API rejects SameSite=None without Secure cookies.
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=
COOKIE_NAME=iocl_refresh
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Facility
FACILITY_CODE=IOCL-COIMBATORE
GATE_CODE=IN-GATE-01

# Next.js frontend
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_DEMO_MODE=false
